# Local, never-shared upgrade state (may contain clear-text owner identifiers)
.claude/upgrade-state.local.json

# Machine-local Claude Code settings (permissions granted on one machine)
.claude/settings.local.json

# Session-end handoff note written by hooks, surfaced at next session start
.claude/.last-session-state

# Quarantined personal content pending manual review
_extracted-personal/

# OS Console per-user prefs overlay (pins, recents) — never canonical truth
os-console/state.json

# npm's install dir — the console is zero-dependency, but a stray install
# must never land in the repo
node_modules/

.DS_Store
